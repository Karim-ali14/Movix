# Copy this file to .env and fill in the values. Never commit .env.

# Used only by scripts/seed.py
TMDB_API_KEY=

# Path to the Firebase service-account JSON (Firebase Console -> Project settings -> Service accounts).
# Leave empty to run without FCM: notifications are then only logged.
FIREBASE_CREDENTIALS_PATH=

# Topic the Android app subscribes to.
FCM_TOPIC=movies

# If set, PATCH requests must send this value in the X-Admin-Key header.
ADMIN_API_KEY=

DATABASE_URL=sqlite:///./movix.db
